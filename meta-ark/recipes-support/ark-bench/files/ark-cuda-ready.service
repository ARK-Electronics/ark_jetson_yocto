# SPDX-License-Identifier: MIT
[Unit]
Description=Record successful ARK CUDA computation milestone
DefaultDependencies=no
Requires=nvpmodel.service
Wants=ark-os-ready.service
After=multi-user.target ark-os-ready.service nvpmodel.service systemd-modules-load.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=ark-bench
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/libexec/ark-readiness cuda
Environment=ARK_READINESS_TTY=/dev/ttyTCU0
StandardOutput=journal
StandardError=journal
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
