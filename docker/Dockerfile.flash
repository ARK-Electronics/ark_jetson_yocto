# SPDX-License-Identifier: MIT
# Ubuntu 24.04 and its package snapshot are pinned together for repeatable tools.
FROM ubuntu:24.04@sha256:69cecf4bbf72d2d44a9eef1b71fb98c7fb973d78af11399deccef19beb008ad9
ARG DEBIAN_FRONTEND=noninteractive
ARG UBUNTU_SNAPSHOT=20260921T000000Z

# The minimal base lacks CA roots. Bootstrap the official, checksummed package
# without disabling HTTPS verification, then install it normally through apt.
ADD --checksum=sha256:641de77d8f142cfd62a1a6f964ba67b20754d3337c480efb529d086075a06c9a \
    https://snapshot.ubuntu.com/ubuntu/20260921T000000Z/pool/main/c/ca-certificates/ca-certificates_20240203_all.deb /tmp/ca-certificates.deb
RUN dpkg-deb --extract /tmp/ca-certificates.deb /tmp/ca-bootstrap && \
    mkdir -p /etc/ssl/certs && \
    cat /tmp/ca-bootstrap/usr/share/ca-certificates/mozilla/*.crt > /etc/ssl/certs/ca-certificates.crt && \
    printf 'Types: deb\nURIs: https://snapshot.ubuntu.com/ubuntu/%s/\nSuites: noble noble-updates noble-security\nComponents: main universe\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' "$UBUNTU_SNAPSHOT" > /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::Check-Valid-Until=false -o APT::Update::Error-Mode=any update && \
    apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends \
        bc binutils bmap-tools bzip2 ca-certificates cpio cpp device-tree-compiler \
        dosfstools e2fsprogs file gdisk kmod libstdc++6 libusb-1.0-0 \
        libxml2-utils lz4 openssl parted python3 python3-cryptography \
        python3-pycryptodome python3-yaml rsync sudo tar udev unzip usbutils \
        util-linux xz-utils zstd && \
    rm -rf /var/lib/apt/lists/* /tmp/ca-bootstrap /tmp/ca-certificates.deb && \
    mkdir -p /usr/local/share && \
    dpkg-query -W > /usr/local/share/flash-package-versions.txt

# NVIDIA's legacy signing utilities consult USER even when the effective UID is 0.
ENV USER=root LANG=C.UTF-8 LC_ALL=C.UTF-8
USER root
WORKDIR /work
ENTRYPOINT ["/bin/bash"]
