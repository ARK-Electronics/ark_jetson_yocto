+
+/*
+ * Read the MCU version before native initialization can reset the PHY. Restrict
+ * this observation to the audited H revision and OCP path. The native getter
+ * changes the indirect RAM address selector (A43/13 -> 801E) and selects page
+ * zero; restore the cached page, but do not call the version-check helper or
+ * change cached MCU flags. Read-command/address-selection writes still occur.
+ * Call only at complete function boundaries where the next native operation
+ * selects its own register address. Completion does not prove RAM validity.
+ */
+static void ark_phy_diag_live_mcu(struct rtl8168_private *tp, const char *stage)
+{
+        u32 saved_page;
+        u16 live_version;
+        unsigned int complete;
+
+        if (!ark_phy_diag || tp->mcfg != CFG_METHOD_30 ||
+            !tp->HwSuppPhyOcpVer || tp->rtk_enable_diag)
+                return;
+
+        saved_page = tp->cur_page;
+        live_version = rtl8168_get_hw_phy_mcu_code_ver(tp);
+        complete = !!(RTL_R32(tp, PHYOCP) & OCPR_Flag);
+        rtl8168_mdio_write(tp, 0x1f, saved_page);
+
+        printk(KERN_INFO "ARK_R8168_PHY stage=%s chipset=%d mcfg=%u "
+               "mcu_live=0x%04x mcu_expected=0x%04x complete=%u "
+               "page_before=0x%x page_after=0x%x mcu_cached=0x%04x "
+               "mcu_loaded=%u\n",
+               stage, tp->chipset, tp->mcfg, (unsigned int)live_version,
+               (unsigned int)tp->sw_ram_code_ver, complete,
+               saved_page, (unsigned int)tp->cur_page,
+               (unsigned int)tp->hw_ram_code_ver,
+               (unsigned int)tp->HwHasWrRamCodeToMicroP);
 }
 
