+
+/*
+ * Opt-in observation only: do not change PHY settings, cached page or MCU flags.
+ * OCP reads address page zero explicitly; unsupported/diagnostic mode is skipped.
+ * BMSR is read twice because link history is latched low. These reads clear that
+ * history and add polling/logging time, so this is not a benchmark configuration.
+ * valid_mask bits follow bmcr, bmsr_latched, bmsr_current, adv, gctrl order.
+ * The completion flag is a transport observation, not a PHY-state guarantee.
+ */
+static void ark_phy_diag_snapshot(struct rtl8168_private *tp, const char *stage)
+{
+        static const u16 regs[] = {
+                MII_BMCR, MII_BMSR, MII_BMSR, MII_ADVERTISE, MII_CTRL1000
+        };
+        u32 values[ARRAY_SIZE(regs)];
+        u32 valid_mask = 0;
+        unsigned int i;
+        u8 status;
+
+        if (!ark_phy_diag)
+                return;
+
+        status = RTL_R8(tp, PHYstatus);
+        for (i = 0; i < ARRAY_SIZE(regs); i++) {
+                values[i] = 0xffffffff;
+                if (!tp->HwSuppPhyOcpVer || tp->rtk_enable_diag)
+                        continue;
+                values[i] = rtl8168_mdio_read_phy_ocp(tp, 0, regs[i]);
+                if (RTL_R32(tp, PHYOCP) & OCPR_Flag)
+                        valid_mask |= 1U << i;
+        }
+
+        printk(KERN_INFO "ARK_R8168_PHY stage=%s chipset=%d mcfg=%u "
+               "unknown=%u ocp=%u diag=%u page=0x%x phy=0x%02x "
+               "phy_valid=%u link=%u valid_mask=0x%x bmcr=0x%08x "
+               "bmsr_latched=0x%08x bmsr_current=0x%08x adv=0x%08x "
+               "gctrl=0x%08x mcu_cached=0x%04x mcu_expected=0x%04x "
+               "mcu_loaded=%u no_ram_write=%u no_mcu_patch=%u "
+               "adc_required=%u adc_offset=0x%04x autoneg=%u speed=%u "
+               "duplex=%u advertising=0x%x eee=%u\n",
+               stage, tp->chipset, tp->mcfg,
+               (unsigned int)tp->HwIcVerUnknown,
+               (unsigned int)tp->HwSuppPhyOcpVer,
+               (unsigned int)tp->rtk_enable_diag, (unsigned int)tp->cur_page,
+               (unsigned int)status, (unsigned int)(status != 0xff),
+               (unsigned int)(status != 0xff && (status & LinkStatus)),
+               valid_mask, values[0], values[1], values[2], values[3], values[4],
+               (unsigned int)tp->hw_ram_code_ver,
+               (unsigned int)tp->sw_ram_code_ver,
+               (unsigned int)tp->HwHasWrRamCodeToMicroP,
+               (unsigned int)tp->NotWrRamCodeToMicroP,
+               (unsigned int)tp->NotWrMcuPatchCode,
+               (unsigned int)tp->RequireAdcBiasPatch,
+               (unsigned int)tp->AdcBiasPatchIoffset,
+               (unsigned int)tp->autoneg, (unsigned int)tp->speed,
+               (unsigned int)tp->duplex, (unsigned int)tp->advertising,
+               (unsigned int)tp->eee.eee_enabled);
 }
 
